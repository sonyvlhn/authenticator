# Conexão do app com o Postgres. Precisa usar as mesmas credenciais de DB_USER/DB_PASSWORD/DB_NAME abaixo.
# Em produção, adicione "?sslmode=require" ao final para criptografar a conexão.
DATABASE_URL="postgresql://admin:troque-esta-senha@localhost:5432/mydb"

# Chave de assinatura dos tokens de login (mínimo de 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=gere-um-valor-aleatorio-com-pelo-menos-32-caracteres

# Credenciais do Postgres usadas pelo docker-compose (precisam ser as mesmas da DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=troque-esta-senha
DB_NAME=mydb

# Login do pgAdmin (docker-compose)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=troque-esta-senha

# Storage de imagens (container "storage" do docker-compose - SeaweedFS compatível com S3)
# As mesmas chaves são usadas pelo container e pelo backend
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_BUCKET=imagens
STORAGE_ACCESS_KEY=storageadmin
STORAGE_SECRET_KEY=troque-esta-senha
# URL pública usada para montar as URLs salvas no banco e carregar as imagens no frontend
NEXT_PUBLIC_STORAGE_URL=http://localhost:8333/imagens

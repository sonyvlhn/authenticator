# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Todos os arquivos .env ficam fora do git (contêm senhas e chaves).
# Exceção: .env.example, que só tem valores de exemplo e serve de modelo para configurar o projeto.
.env*
!.env.example

# graphify (grafo de conhecimento gerado localmente, não faz parte do projeto)
graphify-out/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
